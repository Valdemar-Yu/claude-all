#!/usr/bin/env bash
# cc-gpt-plbbl — 把 Claude Code 经 claudish 接到第三方 GPT 订阅/中转站(plbbl 为默认示例)。
# 原理见 docs/how-it-works.md;排错见 docs/troubleshooting.md。
set -euo pipefail

# 解析自身真实路径(跨 symlink,兼容 macOS 无 readlink -f),定位 lib
_SOURCE="${BASH_SOURCE[0]:-$0}"
while [ -L "$_SOURCE" ]; do
  _DIR="$(cd -P "$(dirname "$_SOURCE")" >/dev/null 2>&1 && pwd)"
  _SOURCE="$(readlink "$_SOURCE")"
  case "$_SOURCE" in /*) : ;; *) _SOURCE="$_DIR/$_SOURCE" ;; esac
done
_SELF_DIR="$(cd -P "$(dirname "$_SOURCE")" >/dev/null 2>&1 && pwd)"

# 找 lib:wrapper 旁的 ../lib > 安装前缀 > 同目录 lib
_LIB=""
for _d in "$_SELF_DIR/../lib" "$HOME/.local/share/claude-all/lib" "$_SELF_DIR/lib"; do
  if [ -f "$_d/config.sh" ]; then _LIB="$_d"; break; fi
done
if [ -z "${_LIB:-}" ]; then
  echo "[cc-gpt-plbbl] 找不到 lib/config.sh。重装:curl -fsSL https://github.com/Valdemar-Yu/claude-all/install.sh | bash" >&2
  exit 1
fi
# shellcheck source=/dev/null
source "$_LIB/config.sh"
source "$_LIB/token.sh"
source "$_LIB/context-window.sh"

# 解析 token
_ccgp_resolve_token || {
  echo "[cc-gpt-plbbl] 没解析到 token。设置 \$CCGP_TOKEN,或在 $CCGP_CONFIG_FILE 写 token= / token_cmd=,或用 CC Switch。" >&2
  exit 1
}

# provider 决定 env 名:oai 一等公民(工具调用稳);litellm 通用但偶发残缺 tool call
case "$CCGP_PROVIDER" in
  oai)     _ENV_PREFIX="OPENAI" ;;
  litellm) _ENV_PREFIX="LITELLM" ;;
  *) echo "[cc-gpt-plbbl] 未知 provider '$CCGP_PROVIDER'(用 oai 或 litellm)" >&2; exit 1 ;;
esac
export "${_ENV_PREFIX}_BASE_URL=$CCGP_BASE_URL"
export "${_ENV_PREFIX}_API_KEY=$CCGP_TOKEN"

# claudish 会生成临时 --settings;通过 claude-all patch 显式换成统一 statusline。
_PREFIX="$(cd -P "$_LIB/.." >/dev/null 2>&1 && pwd)"
_STATUSLINE="$_PREFIX/statusline/statusline.py"
if [ "$CCGP_STATUSLINE" = yes ] && [ -f "$_STATUSLINE" ] && [ -f "$_LIB/statusline.sh" ]; then
  # shellcheck source=/dev/null
  source "$_LIB/statusline.sh"
  export CLAUDISH_STATUSLINE_COMMAND="$(_claude_all_statusline_command "$_PREFIX")"
  export CLAUDISH_STATUSLINE_REFRESH=60
  export CLAUDE_ALL_POOL_USAGE_URL="$CCGP_POOL_USAGE_URL"
  export CLAUDE_ALL_POOL_KEYCHAIN_SERVICE="$CCGP_POOL_KEYCHAIN_SERVICE"
  export CLAUDE_ALL_POOL_COOKIE_NAME="$CCGP_POOL_COOKIE_NAME"
fi

# 独立 config 目录:避开 ~/.claude 里 CC Switch 等写入的 ANTHROPIC_* 污染(否则 claudish 代理被覆盖 → 403)
export CLAUDE_CONFIG_DIR="$CCGP_CONFIG_DIR"

# --model/-m、--effort 已显式传则不覆盖默认
if _claude_all_has_model_arg "$@"; then
  _MODEL_ARGS=()
else
  _MODEL_ARGS=(--model "$CCGP_MODEL")
fi
if _claude_all_has_effort_arg "$@"; then
  _EFFORT_ARGS=()
else
  _EFFORT_ARGS=(--effort "$CCGP_EFFORT")
fi

_ACTIVE_MODEL="$(_claude_all_active_model "$CCGP_MODEL" "$@")"
_claude_all_export_context_window "$_ACTIVE_MODEL"
_claude_all_normalize_claudish_args "$@"

# ── 按当前模型校准 harness auto-compact 窗口 ──────────────────────────
# claudish 给 claude 设 ANTHROPIC_MODEL=oai@<model>,claude 不认识该名 → 按扩展
# 窗口 1M 算 auto-compact;而 plbbl 后端真实窗口小得多(实测 gpt-5.6-sol ~400k),
# 不校准会撑过后端窗口 → 502 "exceeds the context window"。这里按模型把窗口压到真实值,
# 触发 harness 自带的 context 压缩(就是 CLAUDE_CODE_AUTO_COMPACT_WINDOW 机制,非另造)。
# 触发点 = (真实窗口 − 输出余量) × PCT%。sol:(400000−20000)×75% = 285000,与原 380000/75 等价。
_ccgp_active_model() {
  # 从 "$@" 解析 --model/-m(--model X / --model=X / -m X / -m=X);无则回退 $CCGP_MODEL
  local found=0 a
  for a in "$@"; do
    case "$a" in
      --model=*) printf '%s' "${a#--model=}"; return ;;
      -m=*)      printf '%s' "${a#-m=}"; return ;;
      --model|-m) found=1 ;;
      *) [ "$found" = 1 ] && { printf '%s' "$a"; return; } ;;
    esac
  done
  printf '%s' "$CCGP_MODEL"   # --model 未传,或末尾无值
}
_ccgp_context_window() {
  # model → 官方 context window(tokens)。$1 可带 provider@ 前缀,自动剥离。
  # 第一处匹配生效,故具体型号(codex-spark / mini)写在前,泛化系列写在后。
  # 数据源:OpenAI 官方文档/公告,2026-07 核实:
  #   - GPT-5 标准系列(5.0/5.1/5.3/5.5/5.6 及 5.4-mini)= 400k(272k 输入 + 128k 输出);
  #     5.6 经 plbbl 实测吻合(claudish 日志 prompt_tokens 到 369411 仍成功)。
  #   - GPT-5.4 = 最高 1M(922k 输入 + 128k 输出);plbbl 是否放行 1M 未实测,撞 502 改 400000。
  #   - GPT-5.3-Codex-Spark / gpt-5-chat-latest = 128k(明显小于标准系列)。
  # plbbl 中转可能进一步收窄;env 覆盖:CCGP_DEFAULT_CONTEXT_WINDOW(未知模型保守默认)。
  local m="${1##*@}"
  case "$m" in
    *codex-spark*)      echo 128000 ;;
    *gpt-5.4-mini*)     echo 400000 ;;
    *gpt-5.4*)          echo 1000000 ;;
    *gpt-5.6*|*gpt-5.5*|*gpt-5.1*|*gpt-5.3*|gpt-5|gpt-5-*) echo 400000 ;;
    *chat-latest*)      echo 128000 ;;
    *) echo "${CCGP_DEFAULT_CONTEXT_WINDOW:-200000}" ;;
  esac
}
_ACTIVE_MODEL="$(_ccgp_active_model "$@")"
_CTX_WIN="$(_ccgp_context_window "$_ACTIVE_MODEL")"
export CLAUDE_CODE_AUTO_COMPACT_WINDOW=$(( _CTX_WIN - ${CCGP_OUTPUT_HEADROOM:-20000} ))
export CLAUDE_AUTOCOMPACT_PCT_OVERRIDE="${CCGP_AUTOCOMPACT_PCT:-75}"

# 空数组用 ${arr[@]+"${arr[@]}"} 规避 macOS bash 3.2 + set -u 的 unbound 报错
exec claudish ${_MODEL_ARGS[@]+"${_MODEL_ARGS[@]}"} ${_EFFORT_ARGS[@]+"${_EFFORT_ARGS[@]}"} \
  ${CLAUDE_ALL_NORMALIZED_ARGS[@]+"${CLAUDE_ALL_NORMALIZED_ARGS[@]}"}
