# DeepSeek OpenAI 兼容协议，经 claudish 翻译。复制后填 API key，并按账号实际模型调整。
CLAUDE_ALL_SCHEMA=2
CLAUDE_ALL_LAUNCH=claudish
CLAUDE_ALL_LABEL="DeepSeek"
CLAUDE_ALL_PROTOCOL=openai
CLAUDE_ALL_PROVIDER=oai
CLAUDE_ALL_MODELS=$'deepseek-v4-flash\ndeepseek-v4-pro'
CLAUDE_ALL_DEFAULT_MODEL=deepseek-v4-flash
CLAUDE_ALL_SUBAGENT_MODEL=deepseek-v4-flash
CLAUDE_ALL_TEAM_MODEL=deepseek-v4-flash
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_API_KEY=REPLACE_WITH_DEEPSEEK_KEY
