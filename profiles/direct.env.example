# direct 型 profile 示例 — Anthropic 兼容 API（支持 /v1/messages）。
# 推荐用 `claude-all add` 生成；真实 profile 与 API key 绝不入库。
CLAUDE_ALL_SCHEMA=2
CLAUDE_ALL_LAUNCH=direct
CLAUDE_ALL_PROTOCOL=anthropic
# 候选主模型：启动该 profile 时可二次选择
CLAUDE_ALL_MODELS=$'claude-main\nclaude-fast'
CLAUDE_ALL_DEFAULT_MODEL=claude-main
# 默认 subagent 与 Agent Team teammate 模型
CLAUDE_ALL_SUBAGENT_MODEL=claude-fast
CLAUDE_ALL_TEAM_MODEL=claude-main
ANTHROPIC_BASE_URL=https://api.example.com
ANTHROPIC_AUTH_TOKEN=sk-REPLACE_ME
# 可选：隔离配置目录（缺省 ~/.claude-all）
# CLAUDE_CONFIG_DIR="$HOME/.claude-all"
