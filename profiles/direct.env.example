# direct 型 profile 示例 — Anthropic 兼容 API(支持 /v1/messages),env 直连 claude。
# 复制为 ~/.claude-all/profiles/<名字>.env 后填入真实 key。真实 profile 绝不入库。
CLAUDE_ALL_LAUNCH=direct
ANTHROPIC_BASE_URL="https://api.kimi.com/coding"
ANTHROPIC_AUTH_TOKEN="sk-REPLACE_ME"
ANTHROPIC_MODEL="k3"
# 四个槽位指向同一模型:无论 Claude Code 请求哪档都落到该 API 的实际模型上
ANTHROPIC_DEFAULT_OPUS_MODEL="$ANTHROPIC_MODEL"
ANTHROPIC_DEFAULT_SONNET_MODEL="$ANTHROPIC_MODEL"
ANTHROPIC_DEFAULT_FABLE_MODEL="$ANTHROPIC_MODEL"
ANTHROPIC_DEFAULT_HAIKU_MODEL="kimi-for-coding-highspeed"   # 小快模型槽位,没有小模型就也填 $ANTHROPIC_MODEL
CLAUDE_CODE_SUBAGENT_MODEL="kimi-for-coding-highspeed"
# 可选:隔离配置目录(缺省 ~/.claude-all,settings 仅 bypassPermissions,避免 ~/.claude 里 cc-switch 的 env 污染)
# CLAUDE_CONFIG_DIR="$HOME/.claude-all"
#
# 注:Kimi 模型 id 用 k3 / kimi-for-coding / kimi-for-coding-highspeed。
# 不要写 k3[1m]——服务端已拒收("Please set model id as `k3`",实测 2026-07-19)。
