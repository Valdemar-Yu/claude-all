# claudish 型 profile 示例 — OpenAI 协议 API，经 claudish 翻译给 Claude Code。
# 推荐用 `claude-all add` 生成；真实 profile 与 API key 绝不入库。
CLAUDE_ALL_SCHEMA=2
CLAUDE_ALL_LAUNCH=claudish
CLAUDE_ALL_PROTOCOL=openai
CLAUDE_ALL_PROVIDER=oai
# 候选主模型：启动该 profile 时可二次选择
CLAUDE_ALL_MODELS=$'gpt-main\ngpt-fast\ngpt-team'
CLAUDE_ALL_DEFAULT_MODEL=gpt-main
# claudish 角色路由：sonnet=subagent，haiku=Agent Team teammate
CLAUDE_ALL_SUBAGENT_MODEL=gpt-fast
CLAUDE_ALL_TEAM_MODEL=gpt-team
OPENAI_BASE_URL=https://your-relay.example.com/v1
OPENAI_API_KEY=sk-REPLACE_ME
# 可选：推理档位
# CLAUDE_ALL_EFFORT=xhigh
# 可选：隔离配置目录（缺省 ~/.claude-all）
# CLAUDE_CONFIG_DIR="$HOME/.claude-all"
# 可选：PLBBL 账号池 statusline（口令放 macOS Keychain，不写 profile）
# CLAUDE_ALL_POOL_USAGE_URL=https://pool.example.com/api/codex/accounts
# CLAUDE_ALL_POOL_KEYCHAIN_SERVICE="pool.example.com statusline"
# CLAUDE_ALL_POOL_COOKIE_NAME=chatgpt_code_access
