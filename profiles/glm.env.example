# z.ai GLM（Anthropic 兼容协议）。复制到 ~/.claude-all/profiles/claude-glm.env 后填 token。
CLAUDE_ALL_SCHEMA=2
CLAUDE_ALL_LAUNCH=direct
CLAUDE_ALL_LABEL="GLM (z.ai)"
CLAUDE_ALL_PROTOCOL=anthropic
CLAUDE_ALL_MODELS=$'glm-5.2[1m]\nglm-4.5-air'
CLAUDE_ALL_DEFAULT_MODEL='glm-5.2[1m]'
CLAUDE_ALL_SUBAGENT_MODEL='glm-4.5-air'
CLAUDE_ALL_TEAM_MODEL='glm-4.5-air'
ANTHROPIC_BASE_URL=https://api.z.ai/api/anthropic
ANTHROPIC_AUTH_TOKEN=REPLACE_WITH_ZAI_TOKEN
