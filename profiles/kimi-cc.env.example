# Kimi Coding Plan（Anthropic 兼容协议）。复制到 ~/.claude-all/profiles/kimi-cc.env 后填 token。
CLAUDE_ALL_SCHEMA=2
CLAUDE_ALL_LAUNCH=direct
CLAUDE_ALL_LABEL="Kimi Coding Plan"
CLAUDE_ALL_PROTOCOL=anthropic
CLAUDE_ALL_MODELS=$'k3[1m]\nk3'
CLAUDE_ALL_DEFAULT_MODEL='k3[1m]'
CLAUDE_ALL_SUBAGENT_MODEL=k3
CLAUDE_ALL_TEAM_MODEL=k3
ANTHROPIC_BASE_URL=https://api.kimi.com/coding/
ANTHROPIC_AUTH_TOKEN=REPLACE_WITH_KIMI_TOKEN
